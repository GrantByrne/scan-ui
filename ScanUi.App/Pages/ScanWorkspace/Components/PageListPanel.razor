<div class="panel pages">
    <div class="panel-header"><span class="eyebrow">Pages</span><span class="numberpill">03</span></div>
    <div class="pages-list">
        @foreach (var page in Pages)
        {
            <PageThumbnail PageData="@(page)" IsSelected="@(page.Number == 1)" />
        }
    </div>
    <div class="pages-footer"><button class="addpage" type="button"><FolioIcon Name="@FolioIconName.Plus" CssClass="small-icon" />Add another page</button></div>
</div>
