{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install ScanUi.App dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "ci",
        "--prefix",
        "${workspaceFolder}/ScanUi.App"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "dotnet: build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "ScanUi.slnx",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: build ScanUi.App",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "ScanUi.App/ScanUi.App.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "ScanUi.slnx",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run ScanUi.App",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "ScanUi.App/ScanUi.App.csproj",
        "--configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
