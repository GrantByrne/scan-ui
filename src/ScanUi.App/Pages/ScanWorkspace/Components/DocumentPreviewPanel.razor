<div class="panel preview">
    <div class="preview-top">
        <div class="preview-label">Document preview <small>Page 1 of 3</small></div>
        <div class="tools">
            <SuiButton Class="tool" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" title="Auto enhance">
                <StartContent><SuiFolioIcon Name="@FolioIconName.Spark" /></StartContent>
                <ChildContent><span>Enhance</span></ChildContent>
            </SuiButton>
            <SuiButton Class="tool" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" title="Auto crop">
                <StartContent><SuiFolioIcon Name="@FolioIconName.Crop" /></StartContent>
                <ChildContent><span>Crop</span></ChildContent>
            </SuiButton>
            <span class="toolbar-split"></span>
            <SuiButton Class="tool" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" IconOnly="true" title="Rotate 90 degrees" aria-label="Rotate 90 degrees">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Rotate" /></ChildContent>
            </SuiButton>
            <SuiButton Class="tool active" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" IconOnly="true" title="Toggle searchable text" aria-label="Toggle searchable text">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Text" /></ChildContent>
            </SuiButton>
        </div>
    </div>
    <div class="stage">
        <div class="paper-viewport">
            <div class="paper">
                <InvoiceDocument />
            </div>
        </div>
        <span class="stage-watermark">Preview · A4 portrait</span>
    </div>
    <div class="preview-bottom">
        <div class="preview-info"><SuiFolioIcon Name="@FolioIconName.Check" /><span>Auto-straightened · 300 DPI</span></div>
        <div class="zoomtools">
            <SuiButton Variant="@SuiButtonVariant.Light" Color="@SuiButtonColor.Default" IconOnly="true" title="Zoom out" aria-label="Zoom out">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Minus" CssClass="small-icon" /></ChildContent>
            </SuiButton>
            <span>100%</span>
            <SuiButton Variant="@SuiButtonVariant.Light" Color="@SuiButtonColor.Default" IconOnly="true" title="Zoom in" aria-label="Zoom in">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Plus" CssClass="small-icon" /></ChildContent>
            </SuiButton>
            <SuiButton Variant="@SuiButtonVariant.Light" Color="@SuiButtonColor.Default" IconOnly="true" title="Reset zoom" aria-label="Reset zoom">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Max" CssClass="small-icon" /></ChildContent>
            </SuiButton>
        </div>
    </div>
</div>
