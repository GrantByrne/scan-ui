<div class="panel settings">
    <div class="setting-head"><span class="eyebrow">Scan settings</span><SuiFolioIcon Name="@FolioIconName.Settings" CssClass="small-icon setting-icon" /></div>
    <div class="settings-scroll">
        <SuiForms Label="Scanner" For="scanner" HelpText="Sample device — no hardware is connected." CssClass="setting-section">
            <SuiDropdown Id="scanner" Options="@ScannerOptions" @bind-Value="_selectedScanner" aria-describedby="scanner-help" />
        </SuiForms>
        <SuiForms Label="Scan source" For="source" CssClass="setting-section">
            <SuiDropdown Id="source" Options="@SourceOptions" @bind-Value="_selectedSource" />
        </SuiForms>
        <div class="setting-section setting-columns">
            <SuiForms Label="Color mode" For="color">
                <SuiDropdown Id="color" Options="@ColorOptions" @bind-Value="_selectedColor" />
            </SuiForms>
            <SuiForms Label="Resolution" For="dpi">
                <SuiDropdown Id="dpi" Options="@ResolutionOptions" @bind-Value="_selectedResolution" />
            </SuiForms>
        </div>
        <SuiForms Label="Paper size" For="papersize" CssClass="setting-section">
            <SuiDropdown Id="papersize" Options="@PaperSizeOptions" @bind-Value="_selectedPaperSize" />
        </SuiForms>
        <div class="section-separator"></div>
        <div class="setting-section">
            <div class="checkrow"><span>Double-sided scanning</span><SuiToggle Label="Double-sided scanning" @bind-Value="_doubleSided" /></div>
            <div class="checkrow"><span>Automatically deskew</span><SuiToggle Label="Automatically deskew" @bind-Value="_automaticallyDeskew" /></div>
            <div class="checkrow"><span>Remove blank pages</span><SuiToggle Label="Remove blank pages" @bind-Value="_removeBlankPages" /></div>
        </div>
    </div>
    <div class="setting-bottom">
        <div class="ready-pill"><span class="status-dot"></span>Scanner ready <span class="demo-mode">· demo mode</span></div>
        <SuiButton Class="primary scanprimary" Variant="@SuiButtonVariant.Solid" Color="@SuiButtonColor.Primary" FullWidth="true"><StartContent><SuiFolioIcon Name="@FolioIconName.Scan" /></StartContent><ChildContent>Scan pages</ChildContent></SuiButton>
        <div class="keyboardtip">Start a sample scan <span class="kbd">Ctrl</span> + <span class="kbd">Enter</span></div>
    </div>
</div>
