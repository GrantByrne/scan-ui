<div class="panel settings">
    <div class="setting-head"><span class="eyebrow">Scan settings</span><SuiFolioIcon Name="@FolioIconName.Settings" CssClass="small-icon setting-icon" /></div>
    <div class="settings-scroll">
        <div class="setting-section"><label class="formlabel" for="scanner">Scanner</label><div class="selectwrap"><select id="scanner"><option selected>Brother DS-740D</option><option>Choose a scanner…</option></select><SuiFolioIcon Name="@FolioIconName.Chevron" /></div><div class="setting-help">Sample device — no hardware is connected.</div></div>
        <div class="setting-section"><label class="formlabel" for="source">Scan source</label><div class="selectwrap"><select id="source"><option selected>Document feeder</option><option>Manual single sheet</option><option>Flatbed</option></select><SuiFolioIcon Name="@FolioIconName.Chevron" /></div></div>
        <div class="setting-section setting-columns">
            <div><label class="formlabel" for="color">Color mode</label><div class="selectwrap"><select id="color"><option selected>Color</option><option>Grayscale</option><option>Black &amp; white</option></select><SuiFolioIcon Name="@FolioIconName.Chevron" /></div></div>
            <div><label class="formlabel" for="dpi">Resolution</label><div class="selectwrap"><select id="dpi"><option selected>300 DPI</option><option>150 DPI</option><option>600 DPI</option></select><SuiFolioIcon Name="@FolioIconName.Chevron" /></div></div>
        </div>
        <div class="setting-section"><label class="formlabel" for="papersize">Paper size</label><div class="selectwrap"><select id="papersize"><option selected>Auto detect</option><option>US Letter</option><option>A4</option><option>Legal</option><option>Receipt</option></select><SuiFolioIcon Name="@FolioIconName.Chevron" /></div></div>
        <div class="section-separator"></div>
        <div class="setting-section">
            <div class="checkrow"><span>Double-sided scanning</span><button class="toggle on" type="button" aria-pressed="true" aria-label="Double-sided scanning"></button></div>
            <div class="checkrow"><span>Automatically deskew</span><button class="toggle on" type="button" aria-pressed="true" aria-label="Automatically deskew"></button></div>
            <div class="checkrow"><span>Remove blank pages</span><button class="toggle" type="button" aria-pressed="false" aria-label="Remove blank pages"></button></div>
        </div>
    </div>
    <div class="setting-bottom">
        <div class="ready-pill"><span class="status-dot"></span>Scanner ready <span class="demo-mode">· demo mode</span></div>
        <button class="primary scanprimary" type="button"><SuiFolioIcon Name="@FolioIconName.Scan" />Scan pages</button>
        <div class="keyboardtip">Start a sample scan <span class="kbd">Ctrl</span> + <span class="kbd">Enter</span></div>
    </div>
</div>
