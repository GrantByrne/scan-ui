<div class="pageitem @(IsSelected ? "selected" : string.Empty)" aria-current="@(IsSelected ? "page" : null)">
    <div class="thumb">
        <div class="thumb-inner"><div class="thumb-logo"></div><div class="thumb-title"></div><div class="thumb-line"></div><div class="thumb-line med"></div><div class="thumb-line short"></div><div class="thumb-table"><div><span></span><span></span></div><div><span></span><span></span></div><div><span></span><span></span></div></div></div>
    </div>
    <div class="pageitem-bottom">
        <span class="page-number">@($"Page {PageData.Number:00}")</span>
        <span class="page-actions">
            <SuiButton Class="tinybtn" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" IconOnly="true" title="Move page up" aria-label="@($"Move page {PageData.Number} up")">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.ArrowUp" /></ChildContent>
            </SuiButton>
            <SuiButton Class="tinybtn" Variant="@SuiButtonVariant.Ghost" Color="@SuiButtonColor.Default" IconOnly="true" title="Remove page" aria-label="@($"Remove page {PageData.Number}")">
                <ChildContent><SuiFolioIcon Name="@FolioIconName.Trash" /></ChildContent>
            </SuiButton>
        </span>
    </div>
    <div class="pageitem-sub">@PageData.Title · @PageData.Dpi DPI</div>
</div>
