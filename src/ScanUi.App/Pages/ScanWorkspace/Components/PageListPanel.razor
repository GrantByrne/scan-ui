<div class="panel pages">
    <div class="panel-header"><span class="eyebrow">Pages</span><SuiPill CssClass="pill-count">03</SuiPill></div>
    <div class="pages-list">
        @foreach (var page in Pages)
        {
            <PageThumbnail PageData="@(page)" IsSelected="@(page.Number == 1)" />
        }
    </div>
    <div class="pages-footer"><SuiButton Class="addpage" Variant="@SuiButtonVariant.Outlined" Color="@SuiButtonColor.Default" FullWidth="true"><StartContent><SuiFolioIcon Name="@FolioIconName.Plus" CssClass="small-icon" /></StartContent><ChildContent>Add another page</ChildContent></SuiButton></div>
</div>
